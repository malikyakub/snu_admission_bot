# Copy to .env.local for Next.js (or keep using .env — Next loads both).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser / admin login (Project Settings → API → anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Storage buckets (create in Supabase Dashboard → Storage, private):
#   enrollment-photos
#   enrollment-ids
#   enrollment-certificates
#   enrollment-payments
# Or run the Storage section at the end of supabase/schema.sql

# Embeddings: @cf/baai/bge-base-en-v1.5 (768-dim) via Cloudflare Workers AI.
# Used for both ingest + query. API token needs the "Workers AI" permission:
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional local Ollama (not used by default; no official bge-base-en-v1.5)
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=bge-base-en-v1.5

# Groq (Llama 3) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# Fallback when the primary model is rate-limited (429)
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Fast model for AI conversation titles (first exchange only)
# GROQ_TITLE_MODEL=llama-3.1-8b-instant

# Low-confidence handoff (top chunk similarity below this → offer admin)
# HANDOFF_SIMILARITY_THRESHOLD=0.55
