# Copy to .env.local for Next.js (or keep using .env — Next loads both).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage buckets (create in Supabase Dashboard → Storage, private):
#   enrollment-photos
#   enrollment-ids
#   enrollment-certificates
#   enrollment-payments
# Or run the Storage section at the end of supabase/schema.sql

# Embeddings: BAAI/bge-base-en-v1.5 (768-dim) via Hugging Face Inference.
# Ollama does not officially host this model — use HF for ingest + query.
# Fine-grained token needs: "Make calls to Inference Providers"
# https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Optional local Ollama (not used by default; no official bge-base-en-v1.5)
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=bge-base-en-v1.5

# Groq (Llama 3) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# Low-confidence handoff (top chunk similarity below this → offer admin)
# HANDOFF_SIMILARITY_THRESHOLD=0.55
